{
  "schemaVersion": 1,
  "id": "fabric_harvester",
  "version": "${version}",
  "name": "Fabric Harvester",
  "description": "Client-side harvesting, planting, tilling, and bone-meal automation with safety profiles, confirmation, retries, and emergency shutdown.",
  "authors": [
    "MadEthan6"
  ],
  "contact": {
    "sources": "https://github.com/MadEthan6/Harvester",
    "issues": "https://github.com/MadEthan6/Harvester/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/speedmine/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.fabricharvester.client.FabricHarvesterClient"
    ]
  },
  "mixins": [
    "fabric_harvester.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "=26.2",
    "java": ">=25",
    "fabric-api": ">=0.156.0"
  }
}
