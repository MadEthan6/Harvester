{
  "schemaVersion": 1,
  "id": "fabric_harvester",
  "version": "${version}",
  "name": "Fabric Harvester",
  "description": "A Fabric mod providing fast block breaking, fast placing, and crop harvesting/replanting tools with rebindable controls.",
  "authors": [
    "Fabric Harvester Team"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/fabric_harvester/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.fabricharvester.FabricHarvesterMod"
    ],
    "client": [
      "com.fabricharvester.client.FabricHarvesterClient"
    ]
  },
  "mixins": [
    "fabric_harvester.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*"
  }
}
